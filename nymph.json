{
  "manifest_version": 1,
  "id": "worbi",
  "name": "WORBI",
  "kind": "archive",
  "category": "tool",
  "version": "6.3.20",
  "description": "Local-first worldbuilding workspace for lore, characters, locations, timelines, notes, and project planning.",
  "overview": {
    "body": "WORBI is a browser-based worldbuilding tool packaged as a Nymph module. It is designed for writers, game developers, solo creators, and teams who need a local project bible for fictional worlds and production notes.",
    "works_with": [
      "Standalone browser workflow",
      "NymphsCore Manager",
      "Game writing and planning workflows",
      "Blender/Unity/Unreal projects as external reference material"
    ],
    "requirements": [
      "NymphsCore base WSL runtime",
      "Nymphs Brain local AI stack",
      "Local WebView2 or browser access to the WORBI web app"
    ],
    "compatibility": [
      "Runs locally from the managed NymphsCore WSL distro",
      "Keeps WORBI project data under the module data folders during normal uninstall"
    ],
    "links": [
      {
        "label": "WORBI module source",
        "url": "https://github.com/nymphnerds/worbi"
      }
    ]
  },
  "source": {
    "archive": "packages/worbi-6.3.18.tar.gz",
    "format": "tar.gz"
  },
  "entrypoints": {
    "install": "scripts/install_worbi.sh",
    "update": "scripts/worbi_update.sh",
    "status": "scripts/worbi_status.sh",
    "start": "scripts/worbi_start.sh",
    "stop": "scripts/worbi_stop.sh",
    "open": "scripts/worbi_open.sh",
    "logs": "scripts/worbi_logs.sh",
    "uninstall": "scripts/worbi_uninstall.sh",
    "open_data": "scripts/worbi_open_data.sh"
  },
  "capabilities": [
    "install",
    "status",
    "start",
    "stop",
    "open",
    "logs",
    "uninstall"
  ],
  "uninstall": {
    "supports_purge": true,
    "requires_confirmation": true,
    "dry_run_arg": "--dry-run",
    "confirm_arg": "--yes",
    "purge_arg": "--purge",
    "preserve_by_default": [
      "data",
      "projects",
      "config",
      "logs"
    ],
    "removes_by_default": [
      "app runtime files",
      "generated launch scripts"
    ]
  },
  "dependencies": [],
  "ui": {
    "manager_ui": {
      "type": "local_url",
      "title": "WORBI",
      "url": "http://localhost:8082",
      "requires_running": true,
      "start_action": "start"
    },
    "manager_actions": [
      {
        "id": "open_data",
        "label": "Open Data",
        "entrypoint": "open_data",
        "result": "open_directory"
      },
      {
        "id": "start",
        "label": "Start",
        "entrypoint": "start",
        "result": "open_in_manager"
      },
      {
        "id": "stop",
        "label": "Stop",
        "entrypoint": "stop",
        "result": "show_output"
      },
      {
        "id": "browser",
        "label": "Browser",
        "entrypoint": "start",
        "result": "open_external_browser"
      },
      {
        "id": "logs",
        "label": "Logs",
        "entrypoint": "logs",
        "result": "open_notepad"
      }
    ],
    "show_tab_when_installed": true,
    "tab_label": "WORBI",
    "page_kind": "worbi",
    "install_label": "Install WORBI",
    "sort_order": 50
  },
  "runtime": {
    "install_root": "~/worbi",
    "logs_dir": "~/worbi/logs",
    "frontend_url": "http://localhost:8082",
    "backend_url": "http://localhost:8082",
    "health_url": "http://localhost:8082/api/health"
  },
  "update_policy": {
    "channel": "pinned"
  }
}
